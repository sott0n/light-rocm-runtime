  %attn_residual_empty = tensor.empty() : tensor<1x896x@FLOAT_TYPE@>
  %attn_residual = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0, d1)>
      ],
      iterator_types = ["parallel", "parallel"]
    }
      ins(%input, %attn_projected : tensor<1x896x@FLOAT_TYPE@>, tensor<1x896x@FLOAT_TYPE@>)
      outs(%attn_residual_empty : tensor<1x896x@FLOAT_TYPE@>) {
    ^bb0(%residual: @FLOAT_TYPE@, %value: @FLOAT_TYPE@, %out: @FLOAT_TYPE@):
