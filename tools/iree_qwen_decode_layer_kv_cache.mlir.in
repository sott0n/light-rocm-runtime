      ins(%exp_scores0, %row_sums0 : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>, tensor<7x@FLOAT_TYPE@>)
      outs(%prob0_empty : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>) {
    ^bb0(%exp_score: @FLOAT_TYPE@, %row_sum: @FLOAT_TYPE@, %out: @FLOAT_TYPE@):
      %probability = arith.divf %exp_score, %row_sum : @FLOAT_TYPE@
      linalg.yield %probability : @FLOAT_TYPE@
    } -> tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>

  %prob1_empty = tensor.empty() : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>
  %probabilities1 = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0)>,
        affine_map<(d0, d1) -> (d0, d1)>
      ],
      iterator_types = ["parallel", "parallel"]
    }
      ins(%exp_scores1, %row_sums1 : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>, tensor<7x@FLOAT_TYPE@>)
      outs(%prob1_empty : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>) {
    ^bb0(%exp_score: @FLOAT_TYPE@, %row_sum: @FLOAT_TYPE@, %out: @FLOAT_TYPE@):
      %probability = arith.divf %exp_score, %row_sum : @FLOAT_TYPE@
      linalg.yield %probability : @FLOAT_TYPE@
    } -> tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>

  %value_head0_empty = tensor.empty() : tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>
  %value_head0 = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0, d1)>
      ],
      iterator_types = ["parallel", "parallel"]
    }
      ins(%value_cache0 : tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>)
      outs(%value_head0_empty : tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>) {
    ^bb0(%value: @FLOAT_TYPE@, %out: @FLOAT_TYPE@):
      linalg.yield %value : @FLOAT_TYPE@
    } -> tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>

  %value_head1_empty = tensor.empty() : tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>
  %value_head1 = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0, d1)>
      ],
      iterator_types = ["parallel", "parallel"]
    }
      ins(%value_cache1 : tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>)
      outs(%value_head1_empty : tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>) {
    ^bb0(%value: @FLOAT_TYPE@, %out: @FLOAT_TYPE@):
      linalg.yield %value : @FLOAT_TYPE@
    } -> tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>

  %context_heads0_empty = tensor.empty() : tensor<7x64x@FLOAT_TYPE@>
  %context_heads0_init = linalg.fill ins(%zero : @FLOAT_TYPE@)
      outs(%context_heads0_empty : tensor<7x64x@FLOAT_TYPE@>) -> tensor<7x64x@FLOAT_TYPE@>
  %context_heads0 = linalg.matmul
      ins(%probabilities0, %value_head0 : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>, tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>)
      outs(%context_heads0_init : tensor<7x64x@FLOAT_TYPE@>) -> tensor<7x64x@FLOAT_TYPE@>

  %context_heads1_empty = tensor.empty() : tensor<7x64x@FLOAT_TYPE@>
  %context_heads1_init = linalg.fill ins(%zero : @FLOAT_TYPE@)
      outs(%context_heads1_empty : tensor<7x64x@FLOAT_TYPE@>) -> tensor<7x64x@FLOAT_TYPE@>
  %context_heads1 = linalg.matmul
      ins(%probabilities1, %value_head1 : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>, tensor<@CACHE_CAPACITY@x64x@FLOAT_TYPE@>)
      outs(%context_heads1_init : tensor<7x64x@FLOAT_TYPE@>) -> tensor<7x64x@FLOAT_TYPE@>

  %context_empty = tensor.empty() : tensor<1x896x@FLOAT_TYPE@>
  %context_init = linalg.fill ins(%zero : @FLOAT_TYPE@)
      outs(%context_empty : tensor<1x896x@FLOAT_TYPE@>) -> tensor<1x896x@FLOAT_TYPE@>
  %context = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> ((d1 mod 448) floordiv 64, d1 mod 64)>,
        affine_map<(d0, d1) -> ((d1 mod 448) floordiv 64, d1 mod 64)>,
        affine_map<(d0, d1) -> (d0, d1)>
      ],
