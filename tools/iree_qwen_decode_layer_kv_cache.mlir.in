  %ffn_hidden_empty = tensor.empty() : tensor<1x4864x@FLOAT_TYPE@>
  %ffn_hidden = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0, d1)>,
