  %attn_out_empty = tensor.empty() : tensor<1x896x@FLOAT_TYPE@>
  %attn_out_init = linalg.fill ins(%zero : @FLOAT_TYPE@)
      outs(%attn_out_empty : tensor<1x896x@FLOAT_TYPE@>) -> tensor<1x896x@FLOAT_TYPE@>
  %attn_projected = linalg.matmul
      ins(%context, %out_weight : tensor<1x896x@FLOAT_TYPE@>, tensor<896x896x@FLOAT_TYPE@>)
