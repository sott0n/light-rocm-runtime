  %prob0_empty = tensor.empty() : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>
  %probabilities0 = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
