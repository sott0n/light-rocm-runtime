    ^bb0(%residual: @FLOAT_TYPE@, %value: @FLOAT_TYPE@, %out: @FLOAT_TYPE@):
      %sum = arith.addf %residual, %value : @FLOAT_TYPE@
      linalg.yield %sum : @FLOAT_TYPE@
    } -> tensor<1x896x@FLOAT_TYPE@>

  return %key_cache, %value_cache, %result
      : tensor<@CACHE_CAPACITY@x128x@FLOAT_TYPE@>, tensor<@CACHE_CAPACITY@x128x@FLOAT_TYPE@>, tensor<1x896x@FLOAT_TYPE@>
}
