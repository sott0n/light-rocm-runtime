      outs(%mlp_norm_empty : tensor<1x896x@FLOAT_TYPE@>) {
    ^bb0(%value: @FLOAT_TYPE@, %row_sum: @FLOAT_TYPE@, %weight: @FLOAT_TYPE@, %out: @FLOAT_TYPE@):
      %mean_square = arith.mulf %row_sum, %inv_hidden : @FLOAT_TYPE@
      %variance = arith.addf %mean_square, %eps : @FLOAT_TYPE@
      %rms = math.rsqrt %variance : @FLOAT_TYPE@
      %normalized = arith.mulf %value, %rms : @FLOAT_TYPE@
