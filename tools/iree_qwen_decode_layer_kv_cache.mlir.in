      %sigmoid_neg = arith.divf %exp, %denom : @FLOAT_TYPE@
      %sigmoid = arith.select %is_nonnegative, %sigmoid_pos, %sigmoid_neg : @FLOAT_TYPE@
      %silu = arith.mulf %gate_value, %sigmoid : @FLOAT_TYPE@
      %gated = arith.mulf %silu, %up_value : @FLOAT_TYPE@
      linalg.yield %gated : @FLOAT_TYPE@
    } -> tensor<1x4864x@FLOAT_TYPE@>

