      ins(%gate, %up : tensor<1x4864x@FLOAT_TYPE@>, tensor<1x4864x@FLOAT_TYPE@>)
      outs(%ffn_hidden_empty : tensor<1x4864x@FLOAT_TYPE@>) {
    ^bb0(%gate_value: @FLOAT_TYPE@, %up_value: @FLOAT_TYPE@, %out: @FLOAT_TYPE@):
      %is_nonnegative = arith.cmpf oge, %gate_value, %zero : @FLOAT_TYPE@
      %one = arith.constant 1.0 : @FLOAT_TYPE@
      %abs = math.absf %gate_value : @FLOAT_TYPE@
      %neg_abs = arith.negf %abs : @FLOAT_TYPE@
