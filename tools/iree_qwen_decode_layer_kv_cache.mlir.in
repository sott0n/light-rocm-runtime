        affine_map<(d0, d1) -> (d0)>
      ],
      iterator_types = ["parallel", "reduction"]
    }
      ins(%exp_scores0 : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>)
      outs(%sum0_init : tensor<7x@FLOAT_TYPE@>) {
    ^bb0(%exp_value: @FLOAT_TYPE@, %acc: @FLOAT_TYPE@):
      %sum = arith.addf %acc, %exp_value : @FLOAT_TYPE@
      linalg.yield %sum : @FLOAT_TYPE@
    } -> tensor<7x@FLOAT_TYPE@>

  %sum1_empty = tensor.empty() : tensor<7x@FLOAT_TYPE@>
  %sum1_init = linalg.fill ins(%zero : @FLOAT_TYPE@)
      outs(%sum1_empty : tensor<7x@FLOAT_TYPE@>) -> tensor<7x@FLOAT_TYPE@>
  %row_sums1 = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0)>
      ],
      iterator_types = ["parallel", "reduction"]
    }
      ins(%exp_scores1 : tensor<7x@CACHE_CAPACITY@x@FLOAT_TYPE@>)
      outs(%sum1_init : tensor<7x@FLOAT_TYPE@>) {
    ^bb0(%exp_value: @FLOAT_TYPE@, %acc: @FLOAT_TYPE@):
      %sum = arith.addf %acc, %exp_value : @FLOAT_TYPE@
      linalg.yield %sum : @FLOAT_TYPE@
