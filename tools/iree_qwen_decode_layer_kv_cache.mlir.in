    }
      ins(%context_heads0, %context_heads1 : tensor<7x64x@FLOAT_TYPE@>, tensor<7x64x@FLOAT_TYPE@>)
      outs(%context_init : tensor<1x896x@FLOAT_TYPE@>) {
    ^bb0(%value0: @FLOAT_TYPE@, %value1: @FLOAT_TYPE@, %out: @FLOAT_TYPE@):
      %column = linalg.index 1 : index
      %is_kv0 = arith.cmpi ult, %column, %c448 : index
      %value = arith.select %is_kv0, %value0, %value1 : @FLOAT_TYPE@
      linalg.yield %value : @FLOAT_TYPE@
