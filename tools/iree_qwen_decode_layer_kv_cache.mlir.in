  %ffn_out_init = linalg.fill ins(%zero : @FLOAT_TYPE@)
      outs(%ffn_out_empty : tensor<1x896x@FLOAT_TYPE@>) -> tensor<1x896x@FLOAT_TYPE@>
  %ffn_out = linalg.matmul
      ins(%ffn_hidden, %down_weight : tensor<1x4864x@FLOAT_TYPE@>, tensor<4864x896x@FLOAT_TYPE@>)
