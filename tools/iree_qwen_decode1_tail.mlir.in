func.func @TAIL_FUNCTION@(
    %hidden: tensor<1x896x@FLOAT_TYPE@>,
    %final_norm_weight: tensor<896xf32>,
    %lm_head_weight: tensor<896x151936xf32>) -> tensor<1x151936xf32> {
  %zero = arith.constant 0.0 : f32
  %inv_hidden = arith.constant 0.0011160714285714285 : f32
  %eps = arith.constant 0.000001 : f32

  %hidden_f32_empty = tensor.empty() : tensor<1x896xf32>
  %hidden_f32 = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0, d1)>
      ],
      iterator_types = ["parallel", "parallel"]
    }
      ins(%hidden : tensor<1x896x@FLOAT_TYPE@>)
      outs(%hidden_f32_empty : tensor<1x896xf32>) {
    ^bb0(%value: @FLOAT_TYPE@, %out: f32):
      %converted = arith.extf %value : @FLOAT_TYPE@ to f32
      linalg.yield %converted : f32
    } -> tensor<1x896xf32>

  %sum_empty = tensor.empty() : tensor<1xf32>
  %sum_init = linalg.fill
      ins(%zero : f32)
      outs(%sum_empty : tensor<1xf32>) -> tensor<1xf32>
  %sum_squares = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0)>
      ],
      iterator_types = ["parallel", "reduction"]
    }
      ins(%hidden_f32 : tensor<1x896xf32>)
      outs(%sum_init : tensor<1xf32>) {
    ^bb0(%value: f32, %acc: f32):
      %square = arith.mulf %value, %value : f32
      %sum = arith.addf %acc, %square : f32
      linalg.yield %sum : f32
    } -> tensor<1xf32>

  %norm_empty = tensor.empty() : tensor<1x896xf32>
  %norm = linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0)>,
        affine_map<(d0, d1) -> (d1)>,
        affine_map<(d0, d1) -> (d0, d1)>
      ],
      iterator_types = ["parallel", "parallel"]
    }
      ins(%hidden_f32, %sum_squares, %final_norm_weight :
          tensor<1x896xf32>, tensor<1xf32>, tensor<896xf32>)
      outs(%norm_empty : tensor<1x896xf32>) {
    ^bb0(%value: f32, %row_sum: f32, %weight: f32, %out: f32):
      %mean_square = arith.mulf %row_sum, %inv_hidden : f32
      %variance = arith.addf %mean_square, %eps : f32
      %rms = math.rsqrt %variance : f32
      %normalized = arith.mulf %value, %rms : f32
      %scaled = arith.mulf %normalized, %weight : f32
      linalg.yield %scaled : f32
    } -> tensor<1x896xf32>

  %norm_vec = tensor.collapse_shape %norm [[0, 1]]
      : tensor<1x896xf32> into tensor<896xf32>
  %logits_empty = tensor.empty() : tensor<151936xf32>
  %logits_init = linalg.fill
      ins(%zero : f32)
      outs(%logits_empty : tensor<151936xf32>) -> tensor<151936xf32>
  %logits_vec = linalg.vecmat
      ins(%norm_vec, %lm_head_weight : tensor<896xf32>, tensor<896x151936xf32>)
      outs(%logits_init : tensor<151936xf32>) -> tensor<151936xf32>
  %logits = tensor.expand_shape %logits_vec [[0, 1]]
      output_shape [1, 151936]
      : tensor<151936xf32> into tensor<1x151936xf32>

  return %logits : tensor<1x151936xf32>
}
